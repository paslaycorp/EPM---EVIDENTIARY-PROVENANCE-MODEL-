{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epm:schema:authority-request:v1",
  "title": "EPM Authority Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "actor",
    "action",
    "resource",
    "purpose",
    "scope",
    "jurisdiction",
    "at",
    "authority",
    "policy_id",
    "policy_version",
    "consequence"
  ],
  "properties": {
    "schema_version": {
      "const": "epm.authority-request/1.0"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "consequence": {
      "type": "string",
      "minLength": 1
    }
  }
}
